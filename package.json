{
  "name": "carconfig-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "dev": "vite",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview --port 4173",
    "generate-api": "rimraf src/app/api && npx @openapitools/openapi-generator-cli generate -i openapi/api-docs.yaml -g typescript-angular -o src/app/core/api --additional-properties=withInterfaces=true",
    "generate-api:live": "npx @openapitools/openapi-generator-cli generate -i http://localhost:8090/api/v3/api-docs -g typescript-angular -o src/app/api --additional-properties=withInterfaces=true",
    "build": "vite build",
    "build:ng": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "@loaders.gl/draco": "^4.4.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngrx/component-store": "^22.0.0-beta.0",
    "@ngrx/signals": "^22.0.0-beta.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.2",
    "three": "^0.185.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular/build": "22.0.9",
    "@angular/cli": "22.0.9",
    "@angular/compiler-cli": "22.0.8",
    "@angular/localize": "22.0.8",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/bootstrap": "^5.2.11",
    "@types/jasmine": "~6.0.0",
    "@types/three": "^0.185.1",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vite": "^7.1.5"
  }
}
